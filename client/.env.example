# ── Client environment ──────────────────────────────────────────────────────
# Copy to `.env` and fill in. Only VITE_-prefixed vars reach the browser.

# Base URL of the API + Socket.IO server (no trailing slash)
VITE_BASE_URL=http://localhost:5000

# Google OAuth client ID (same value as GOOGLE_CLIENT_ID in server/.env)
VITE_GOOGLE_CLIENT_ID=

# Funnel analytics collector for the Phase 2 success metrics (see
# shared/lib/analytics.ts). Leave EMPTY to disable all tracking — the client
# sends nothing when this is unset. Must be a CORS-enabled endpoint that accepts
# a POST with Content-Type: application/json.
# VITE_ANALYTICS_ENDPOINT=
