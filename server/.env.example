PORT=8080
NODE_ENV=development

# MongoDB Atlas (free M0) or local Mongo
DB_URI=mongodb://127.0.0.1:27017/whisper-wave

# At least 32 characters
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Admin panel (optional locally; login returns 503 if empty)
# ADMIN_SECRET must be at least 16 characters when set
ADMIN_SECRET=
# Optional; defaults to ACCESS_TOKEN_SECRET (min 32 if set). Use a separate value in production.
# ADMIN_TOKEN_SECRET=

# Frontend origin (password-reset links + CORS). Local Vite default if empty: http://localhost:5173
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GIF search (Klipy) — optional; GIF features degrade if unset
KLIPY_API_KEY=

# Email (signup OTP + password reset). Without SMTP_HOST/USER/PASS, messages are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Whisper Wave <noreply@example.com>"

# Google Sign-In (OAuth Web client ID from console.cloud.google.com). Same value as client VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
