PORT=8080
NODE_ENV=development

# MongoDB Atlas (free M0) or local Mongo
DB_URI=mongodb://127.0.0.1:27017

# At least 32 characters
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Admin panel (optional locally; login returns 503 if empty)
# ADMIN_SECRET must be at least 16 characters when set
ADMIN_SECRET=
# Optional; defaults to ACCESS_TOKEN_SECRET (min 32 if set)
# ADMIN_TOKEN_SECRET=

# Frontend origin in production (leave empty for local Vite)
CLIENT_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
