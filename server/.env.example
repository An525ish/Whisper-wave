PORT=8080
NODE_ENV=development

# MongoDB Atlas (free M0) or local Mongo
DB_URI=mongodb://127.0.0.1:27017/whisper-wave

# At least 32 characters
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Admin panel (optional locally; login returns 503 if empty)
# ADMIN_SECRET must be at least 16 characters when set
ADMIN_SECRET=
# REQUIRED in production (min 32 chars, different from ACCESS_TOKEN_SECRET).
# In development it falls back to ACCESS_TOKEN_SECRET with a warning.
# ADMIN_TOKEN_SECRET=

# Reverse-proxy hops in front of the server (Express `trust proxy`). Default 1.
# Set 0 when exposed directly; raise it for each extra proxy/CDN layer, or
# per-IP rate limits will key off the wrong address.
# TRUST_PROXY_HOPS=1

# Frontend origin (password-reset links + CORS). Local Vite default if empty: http://localhost:5173
CLIENT_URL=http://localhost:5173

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yourId

# GIF search (Klipy) — optional; GIF features degrade if unset
KLIPY_API_KEY=

# Email (signup OTP + password reset). Without SMTP_HOST/USER/PASS, messages are logged to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Whisper Wave <noreply@example.com>"

# Google Sign-In (OAuth Web client ID from console.cloud.google.com). Same value as client VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Redis — Phase 2 anonymous matching
# Local dev: redis://localhost:6379  |  Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Prefix for every Redis key. Leave EMPTY for dev/prod. Tests force their own
# prefix ('test:'), so `npm test` can never touch live keys; do not set this to
# 'test:' on a Redis you care about.
# REDIS_KEY_PREFIX=

# Set to 'true' ONLY if your Redis provider presents a cert chain Node cannot
# verify. Leave unset in production — full TLS verification is the default.
# REDIS_TLS_INSECURE=false

# Separate secret for short-lived anonymous connectTokens (min 32 chars).
# Must NOT be the same as ACCESS_TOKEN_SECRET: a compromised access token must
# not be usable to forge connection intent.
ANON_JWT_SECRET=replace_with_a_long_random_secret_for_anon_tokens

# How long a connectToken is valid after mutual like (minutes, default 10)
# ANON_TOKEN_TTL_MIN=10
